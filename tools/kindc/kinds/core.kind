/// Metadata about a Kind itself
kind thingos.kind = struct {
  name: string,
  version: u32,
  doc: option<string>,
}

/// Canonical first-class object in the typed world.
/// Every Thing has exactly one Kind; identity is carried separately as ThingId.
kind thingos.thing = struct {
  kind: ref<thingos.kind>,
}

/// A representation of a Schema with an encoding
kind thingos.form = struct {
  name: string,
  kind: ref<thingos.kind>,
  encoding: string,
}
