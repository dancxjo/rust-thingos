@@ -36,6 +36,70 @@ use std::sync::Arc;
 use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
 use std::thread;

+#[cfg(target_os = "thingos")]
+use core::ffi::c_void;
+
+#[cfg(target_os = "thingos")]
+type PthreadT = u64;
+
+#[cfg(target_os = "thingos")]
+type WorkerThunk = Box<dyn FnOnce() + Send>;
+
+#[cfg(target_os = "thingos")]
+unsafe extern "C" {
+    fn pthread_create(
+        thread: *mut PthreadT,
+        attr: *const c_void,
+        start_routine: extern "C" fn(*mut c_void) -> *mut c_void,
+        arg: *mut c_void,
+    ) -> i32;
+    fn pthread_detach(thread: PthreadT) -> i32;
+}
+
+#[cfg(target_os = "thingos")]
+extern "C" fn worker_start_trampoline(arg: *mut c_void) -> *mut c_void {
+    // SAFETY: arg is allocated in spawn_worker_thread and always points to a boxed WorkerThunk.
+    let thunk = unsafe { Box::from_raw(arg.cast::<WorkerThunk>()) };
+    thunk();
+    core::ptr::null_mut()
+}
+
+fn spawn_worker_thread<F>(f: F)
+where
+    F: FnOnce() + Send + 'static,
+{
+    #[cfg(target_os = "thingos")]
+    {
+        let thunk: WorkerThunk = Box::new(f);
+        let raw_thunk = Box::into_raw(Box::new(thunk)).cast::<c_void>();
+        let mut tid: PthreadT = 0;
+        let rc = unsafe {
+            pthread_create(
+                &mut tid as *mut PthreadT,
+                core::ptr::null(),
+                worker_start_trampoline,
+                raw_thunk,
+            )
+        };
+        if rc != 0 {
+            // SAFETY: raw_thunk has not been consumed by a successful pthread_create.
+            unsafe {
+                drop(Box::from_raw(raw_thunk.cast::<WorkerThunk>()));
+            }
+            return;
+        }
+
+        unsafe {
+            let _ = pthread_detach(tid);
+        }
+    }
+
+    #[cfg(not(target_os = "thingos"))]
+    {
+        let _ = thread::spawn(f);
+    }
+}
