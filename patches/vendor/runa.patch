+fn delete_path(path: &PathBuf, move_to_trash: bool) -> Result<(), String> {
+    #[cfg(target_os = "thingos")]
+    {
+        // ThingOS does not provide a desktop trash backend yet; fallback to hard delete.
+        let _ = move_to_trash;
+        if path.is_dir() {
+            std::fs::remove_dir_all(path).map_err(|e| e.to_string())
+        } else {
+            std::fs::remove_file(path).map_err(|e| e.to_string())
+        }
+    }
+
+    #[cfg(not(target_os = "thingos"))]
+    {
+        if move_to_trash {
+            trash::delete(path).map_err(|e| e.to_string())
+        } else if path.is_dir() {
+            std::fs::remove_dir_all(path).map_err(|e| e.to_string())
+        } else {
+            std::fs::remove_file(path).map_err(|e| e.to_string())
+        }
+    }
+}
