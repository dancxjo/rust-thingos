+use std::{collections::VecDeque, io, io::Read, time::Duration};
+
+#[cfg(feature = "event-stream")]
+use crate::event::sys::Waker;
+use crate::event::sys::unix::parse::parse_event;
+use crate::event::{source::EventSource, InternalEvent};
+
+const TTY_BUFFER_SIZE: usize = 1024;
+
+#[derive(Debug)]
+struct Parser {
+    buffer: Vec<u8>,
+    internal_events: VecDeque<InternalEvent>,
+}
+
+impl Default for Parser {
+    fn default() -> Self {
+        Self {
+            buffer: Vec::with_capacity(256),
+            internal_events: VecDeque::with_capacity(128),
+        }
+    }
+}
+
+impl Parser {
+    fn advance(&mut self, buffer: &[u8], more: bool) {
+        for (idx, byte) in buffer.iter().enumerate() {
+            let has_more = idx + 1 < buffer.len() || more;
+            self.buffer.push(*byte);
+
+            match parse_event(&self.buffer, has_more) {
+                Ok(Some(event)) => {
+                    self.internal_events.push_back(event);
+                    self.buffer.clear();
+                }
+                Ok(None) => {}
+                Err(_) => {
+                    self.buffer.clear();
+                }
+            }
+        }
+    }
+}
+
+impl Iterator for Parser {
+    type Item = InternalEvent;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.internal_events.pop_front()
+    }
+}
+
+pub(crate) struct UnixInternalEventSource {
+    parser: Parser,
+    tty_buffer: [u8; TTY_BUFFER_SIZE],
+}
+
+impl UnixInternalEventSource {
+    pub fn new() -> io::Result<Self> {
+        Ok(Self {
+            parser: Parser::default(),
+            tty_buffer: [0u8; TTY_BUFFER_SIZE],
+        })
+    }
+}
+
+impl EventSource for UnixInternalEventSource {
+    fn try_read(&mut self, timeout: Option<Duration>) -> io::Result<Option<InternalEvent>> {
+        if let Some(event) = self.parser.next() {
+            return Ok(Some(event));
+        }
+
+        if timeout.is_some_and(|d| d.is_zero()) {
+            return Ok(None);
+        }
+
+        let read_count = io::stdin().read(&mut self.tty_buffer)?;
+        if read_count == 0 {
+            return Ok(None);
+        }
+
+        self.parser
+            .advance(&self.tty_buffer[..read_count], read_count == TTY_BUFFER_SIZE);
+        Ok(self.parser.next())
+    }
+
+    #[cfg(feature = "event-stream")]
+    fn waker(&self) -> Waker {
+        panic!("event-stream waker is not supported on thingos")
+    }
+}
