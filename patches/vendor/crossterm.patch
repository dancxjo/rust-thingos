new file mode 100644
--- /dev/null
+++ b/src/terminal/sys/thingos.rs
@@ -0,0 +1,145 @@
+//! ThingOS terminal backend backed by libc termios/ioctl shims.
+
+use std::{io, mem};
+
+use parking_lot::Mutex;
+
+use crate::terminal::WindowSize;
+
+const TCSANOW: i32 = 0;
+const TIOCGWINSZ: u64 = 0x5413;
+
+const BRKINT: u32 = 0x0002;
+const ICRNL: u32 = 0x0100;
+const INPCK: u32 = 0x0010;
+const ISTRIP: u32 = 0x0020;
+const IXON: u32 = 0x0400;
+
+const OPOST: u32 = 0x0001;
+
+const CSIZE: u32 = 0x0030;
+const CS8: u32 = 0x0030;
+
+const ECHO: u32 = 0x0008;
+const ICANON: u32 = 0x0002;
+const IEXTEN: u32 = 0x8000;
+const ISIG: u32 = 0x0001;
+
+const VTIME: usize = 5;
+const VMIN: usize = 6;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Termios {
+    c_iflag: u32,
+    c_oflag: u32,
+    c_cflag: u32,
+    c_lflag: u32,
+    c_line: u8,
+    _pad: [u8; 3],
+    c_cc: [u8; 32],
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct WinSize {
+    ws_row: u16,
+    ws_col: u16,
+    ws_xpixel: u16,
+    ws_ypixel: u16,
+}
+
+unsafe extern "C" {
+    fn tcgetattr(fd: i32, termios_p: *mut Termios) -> i32;
+    fn tcsetattr(fd: i32, optional_actions: i32, termios_p: *const Termios) -> i32;
+    fn ioctl(fd: i32, request: u64, argp: *mut core::ffi::c_void) -> i32;
+}
+
+// Some(Termios) means raw mode is active and stores the prior mode.
+static TERMINAL_MODE_PRIOR_RAW_MODE: Mutex<Option<Termios>> = parking_lot::const_mutex(None);
+
+impl From<WinSize> for WindowSize {
+    fn from(size: WinSize) -> WindowSize {
+        WindowSize {
+            columns: size.ws_col,
+            rows: size.ws_row,
+            width: size.ws_xpixel,
+            height: size.ws_ypixel,
+        }
+    }
+}
+
+pub(crate) fn is_raw_mode_enabled() -> bool {
+    TERMINAL_MODE_PRIOR_RAW_MODE.lock().is_some()
+}
+
+pub(crate) fn enable_raw_mode() -> io::Result<()> {
+    let mut original_mode = TERMINAL_MODE_PRIOR_RAW_MODE.lock();
+    if original_mode.is_some() {
+        return Ok(());
+    }
+
+    let fd = 0;
+    let mut ios = get_terminal_attr(fd)?;
+    let original_mode_ios = ios;
+    raw_terminal_attr(&mut ios);
+    set_terminal_attr(fd, &ios)?;
+    *original_mode = Some(original_mode_ios);
+    Ok(())
+}
+
+pub(crate) fn disable_raw_mode() -> io::Result<()> {
+    let mut original_mode = TERMINAL_MODE_PRIOR_RAW_MODE.lock();
+    if let Some(original_mode_ios) = original_mode.as_ref() {
+        let fd = 0;
+        set_terminal_attr(fd, original_mode_ios)?;
+        *original_mode = None;
+    }
+    Ok(())
+}
+
+#[allow(clippy::useless_conversion)]
+pub(crate) fn window_size() -> io::Result<WindowSize> {
+    let mut size = WinSize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };
+
+    let fd = 1;
+
+    if wrap_with_result(unsafe { ioctl(fd, TIOCGWINSZ, (&mut size as *mut WinSize).cast()) })
+        .is_ok()
+    {
+        return Ok(size.into());
+    }
+
+    Err(io::Error::last_os_error())
+}
+
+pub(crate) fn size() -> io::Result<(u16, u16)> {
+    let ws = window_size()?;
+    Ok((ws.columns, ws.rows))
+}
+
+fn raw_terminal_attr(termios: &mut Termios) {
+    termios.c_iflag &= !(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
+    termios.c_oflag &= !OPOST;
+    termios.c_cflag &= !CSIZE;
+    termios.c_cflag |= CS8;
+    termios.c_lflag &= !(ECHO | ICANON | IEXTEN | ISIG);
+    termios.c_cc[VMIN] = 1;
+    termios.c_cc[VTIME] = 0;
+}
+
+fn get_terminal_attr(fd: i32) -> io::Result<Termios> {
+    unsafe {
+        let mut termios = mem::zeroed();
+        wrap_with_result(tcgetattr(fd, &mut termios))?;
+        Ok(termios)
+    }
+}
+
+fn set_terminal_attr(fd: i32, termios: &Termios) -> io::Result<()> {
+    wrap_with_result(unsafe { tcsetattr(fd, TCSANOW, termios) })
+}
+
+fn wrap_with_result(result: i32) -> io::Result<()> {
+    if result == -1 { Err(io::Error::last_os_error()) } else { Ok(()) }
+}
+
+#[cfg(feature = "events")]
+pub fn supports_keyboard_enhancement() -> io::Result<bool> {
+    Ok(false)
+}
